# dependencies
node_modules/

# environment files (secrets) - only the .env.example templates are committed
.env
.env.*
!.env.example
# The client's production API URL is public configuration, not a secret
!client/.env.production

# build output
dist/
build/
coverage/

# uploaded files are runtime data, not source code
server/uploads/*
!server/uploads/.gitkeep
server/tests/.uploads/

# logs
logs/
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# assessment brief from the company - keep it out of the (possibly public) repository
/*.pdf

# documentation folder - not pushed to the public repository
docs/
