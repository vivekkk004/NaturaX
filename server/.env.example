# Copy this file to `.env` and adjust. Never commit the real .env.

NODE_ENV=development
PORT=5000

# Local MongoDB. Add ?replicaSet=rs0 once the single-node replica set is enabled (see README),
# which turns on multi-document transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/naturax_followup

# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Uploaded import files are stored here (relative to the server folder); the DB stores only the path
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Global API rate limit: max requests per IP per window
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500
# Failed login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=10

# Auth - generate a strong secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

# Serve the built UI (client/dist) from this server. Defaults to true when NODE_ENV=production.
# Set to false when the UI is hosted elsewhere (e.g. Vercel).
# SERVE_CLIENT=true

# Refresh-cookie SameSite: leave unset for automatic (strict on the same site; none + Secure in
# production when an allowed CLIENT_ORIGIN on another site calls the API). Override: strict|lax|none
# COOKIE_SAME_SITE=

# Number of reverse proxies in front of the app (Render = 1). Default: 1 in production, else 0.
# TRUST_PROXY=1

# Rule engine: re-evaluate time-based rules on a schedule (cron syntax, Asia/Kolkata time)
RULE_ENGINE_CRON=*/15 * * * *
RULE_ENGINE_CRON_ENABLED=true
